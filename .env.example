# Copy to .env.local for npm run dev.
# Set the same keys in Vercel Project Settings > Environment Variables for production.

# Server-side waitlist API (required for /api/waitlist)
SUPABASE_URL=https://knrlengeubuxadcrdtso.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Aliases also supported locally:
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERIVE_ROLE_KEY=

# Confirmation emails via Resend (required for signup confirmation email)
# 1. Create an account at https://resend.com
# 2. Verify the standen.io domain (DNS records in Resend dashboard)
# 3. Create an API key and paste it below (replace re_xxxxxxxxx with your real key)
RESEND_API_KEY=re_xxxxxxxxx
# For testing before standen.io is verified, use: onboarding@resend.dev
WAITLIST_FROM_EMAIL=Standen <waitlist@standen.io>
WAITLIST_REPLY_TO=tomas@standen.io
WAITLIST_NOTIFY_TO=tomas@standen.io
